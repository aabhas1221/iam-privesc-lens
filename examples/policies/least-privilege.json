{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::acme-app-assets",
        "arn:aws:s3:::acme-app-assets/*"
      ]
    },
    {
      "Sid": "PassOnlyLambdaExecRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::123456789012:role/acme-lambda-exec",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyIamWrites",
      "Effect": "Deny",
      "Action": [
        "iam:Create*",
        "iam:Put*",
        "iam:Attach*",
        "iam:Update*"
      ],
      "Resource": "*"
    }
  ]
}